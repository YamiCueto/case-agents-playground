# ==============================================================================
# AGENT ENGINEERING PLAYGROUND (AEP) — CONFIGURACIÓN DEL ENTORNO LOCAL (.env)
# ==============================================================================
# Copia este archivo como '.env' en la raíz del proyecto para tu entorno local:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
#
# IMPORTANTE: El archivo '.env' está ignorado en Git (.gitignore) y nunca debe
# versionarse ni contener credenciales reales de producción.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS RELACIONAL (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# Servidor y base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cfa_tickets

# Usuario Administrador (DDL):
# Utilizado por scripts/bootstrap_db.py y Alembic para crear la base de datos y otorgar permisos.
# En instalaciones locales típicas de XAMPP / MariaDB la contraseña suele ser vacía.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Usuario de Aplicación (DML):
# Utilizado por FastAPI para operar el sistema con privilegios mínimos (SELECT, INSERT, UPDATE, DELETE).
# Si DB_ADMIN_USER == DB_APP_USER, la aplicación operará directamente con el usuario administrador.
DB_APP_USER=cfa_app_user
DB_APP_PASSWORD=CHANGE_ME_LOCAL

# ------------------------------------------------------------------------------
# 2. SERVIDOR LLM LOCAL (llama.cpp / API OpenAI-compatible)
# ------------------------------------------------------------------------------
# Endpoint HTTP del servidor de inferencia local o proxy compatible
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local-llama-cpp

# Identificador explícito del modelo (opcional).
# Si se deja vacío, AEP descubrirá automáticamente el modelo cargado mediante /v1/models.
LLM_MODEL=

# ------------------------------------------------------------------------------
# 3. BACKEND FASTAPI & POLÍTICAS CORS
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000,http://127.0.0.1:3000
